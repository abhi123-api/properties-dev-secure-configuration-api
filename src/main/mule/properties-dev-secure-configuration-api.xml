		<db:my-sql-connection host="${database.host}" port="${database.port}" user="${database.user}" password="${secure::database.password}" database="${database.training}" />
	</db:config>
	<configuration-properties doc:name="Configuration properties" doc:id="5454bc84-4048-4547-817f-9f85c5e23b83" file="C:\Users\pradeep borate\Downloads\Desktop\Properties\ext-${env}.properties"/>
	<secure-properties:config name="Secure_Properties_Config" doc:name="Secure Properties Config" doc:id="37bbb411-2efb-4838-bcef-de813aab4524" file='C:\Users\pradeep borate\Downloads\Desktop\Properties\ext-${env}-secure.properties' key="${encrypt-name-key}" />
